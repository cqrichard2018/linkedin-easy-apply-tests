# ---- Test users (at least one required) -------------------------------------
# Strategy A (preferred locally): credentials. First login may need 2FA — run
# `npm run auth` (headed) once and complete it manually; the session is then
# persisted to .auth/ and reused.
LINKEDIN_USER_A_EMAIL=
LINKEDIN_USER_A_PASSWORD=
LINKEDIN_USER_B_EMAIL=
LINKEDIN_USER_B_PASSWORD=

# Strategy B (preferred in CI): reuse an existing session cookie instead of
# logging in through the UI (avoids CAPTCHA on data-center IPs).
# Copy `li_at` from DevTools > Application > Cookies on a logged-in browser.
LINKEDIN_USER_A_LI_AT=
LINKEDIN_USER_B_LI_AT=

# ---- Search target -----------------------------------------------------------
SEARCH_KEYWORDS=Software Engineer
SEARCH_LOCATION=United States

# Run headed (used by `npm run auth`)
HEADED=0
